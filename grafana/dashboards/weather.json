{
  "uid": "weather",
  "title": "Weather readings",
  "tags": ["weather"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperature",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "weather-api" },
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "weather-api" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/readings",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "recorded_at", "text": "Time", "type": "timestamp" },
            { "selector": "device_id", "text": "Device", "type": "string" },
            { "selector": "temperature", "text": "Temperature", "type": "number" }
          ]
        }
      ],
      "transformations": [
        { "id": "partitionByValues", "options": { "fields": ["Device"], "keepFields": false, "naming": { "asLabels": false } } }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pressure",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "weather-api" },
      "fieldConfig": { "defaults": { "unit": "pressurehpa" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "weather-api" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/readings",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "recorded_at", "text": "Time", "type": "timestamp" },
            { "selector": "device_id", "text": "Device", "type": "string" },
            { "selector": "pressure", "text": "Pressure", "type": "number" }
          ]
        }
      ],
      "transformations": [
        { "id": "partitionByValues", "options": { "fields": ["Device"], "keepFields": false, "naming": { "asLabels": false } } }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Humidity",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "weather-api" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "weather-api" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/readings",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "recorded_at", "text": "Time", "type": "timestamp" },
            { "selector": "device_id", "text": "Device", "type": "string" },
            { "selector": "humidity", "text": "Humidity", "type": "number" }
          ]
        }
      ],
      "transformations": [
        { "id": "partitionByValues", "options": { "fields": ["Device"], "keepFields": false, "naming": { "asLabels": false } } }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "All readings",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "weather-api" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "weather-api" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/readings",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "id", "text": "ID", "type": "number" },
            { "selector": "recorded_at", "text": "Recorded at", "type": "timestamp" },
            { "selector": "device_id", "text": "Device", "type": "string" },
            { "selector": "temperature", "text": "Temperature (°C)", "type": "number" },
            { "selector": "pressure", "text": "Pressure (hPa)", "type": "number" },
            { "selector": "humidity", "text": "Humidity (%)", "type": "number" }
          ]
        }
      ],
      "options": { "sortBy": [{ "displayName": "ID", "desc": true }] }
    }
  ]
}
